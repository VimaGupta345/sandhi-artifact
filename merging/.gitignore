# model weights & datasets (not part of the artifact repo)
hf_cache/
*.safetensors
# python
__pycache__/
*.pyc
.DS_Store
# runtime-generated eval-split configs (embed environment-local paths; see micr/eval_split_configs/README.md)
micr/eval_split_configs/*.yaml
micr/eval_split_configs/*.spec.json
micr/eval_split_configs/_micr_split_*.py

